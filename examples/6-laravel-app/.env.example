APP_NAME="Transcribe Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Transcribe API (your self-hosted server). Keep the key and the secret private.
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
# worker = your PC (free, slower) | cloud = Groq/OpenAI (needs a cloud key on the API server)
TRANSCRIBE_ENGINE=
# Empty = auto-detect
TRANSCRIBE_LANGUAGE=
# Dashboard -> project -> Settings -> Webhook secret
TRANSCRIBE_WEBHOOK_SECRET=
# Optional: public URL of /webhooks/transcribe (empty = this app's own URL)
TRANSCRIBE_WEBHOOK_URL=
# Seconds: uploads / other calls
TRANSCRIBE_TIMEOUT=120
TRANSCRIBE_READ_TIMEOUT=8
# Show the /tester page (turn off on a public server)
TRANSCRIBE_TESTER=true
# Optional: biggest upload in MB (PHP upload_max_filesize can make it smaller)
TRANSCRIBE_MAX_UPLOAD_MB=100
# Optional: keep a copy of each mp3 so the App page can play it (storage/app/private/audio)
TRANSCRIBE_KEEP_AUDIO=true
# Optional: how the tester sends a test webhook: auto | direct | http
TRANSCRIBE_SIMULATE_VIA=auto
