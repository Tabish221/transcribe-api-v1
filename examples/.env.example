# Shared settings for every demo in this folder. Copy this file to .env and fill it in.
# Keep .env private: it is in .gitignore. Never commit it.

# Where the API is installed, WITHOUT /api/v1 (e.g. https://transcribe.example.com)
TRANSCRIBE_API_URL=http://127.0.0.1:8088
# Project API key: Dashboard -> project -> API keys (starts with tk_)
TRANSCRIBE_API_KEY=
# Engine: worker = your PC (free, slower) | cloud = Groq/OpenAI (needs a cloud key on the server)
TRANSCRIBE_ENGINE=worker
# Language: ISO-639-1 code (en, de, ur, ...), auto = detect, empty = the project's default
TRANSCRIBE_LANGUAGE=en
# Webhook secret: Dashboard -> project -> Settings. Used by 4-webhook, 7-python and the testers.
TRANSCRIBE_WEBHOOK_SECRET=
