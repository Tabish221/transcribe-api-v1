{
  "name": "transcribe-api-worker",
  "version": "1.0.0",
  "private": true,
  "description": "PC worker for Transcribe API: claims jobs from the server and transcribes them locally with Whisper (transformers.js).",
  "type": "module",
  "main": "worker.js",
  "scripts": {
    "start": "node worker.js",
    "once": "node worker.js --once",
    "test": "node ../tests/worker-mock-server.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "ffmpeg-static": "^5.3.0"
  }
}
