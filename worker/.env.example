# Transcribe API worker settings. Copy this file to ".env" (same folder) and fill in the first two values.
# Real environment variables override this file. Relative paths are relative to this folder.

# Where the server (dashboard) lives, without a trailing slash.
API_BASE=https://opraviq.com/transcribe

# One of the tokens listed in server/config.php -> 'worker' => ['tokens' => [...]]. Keep it secret.
WORKER_TOKEN=

# Name shown on jobs in the dashboard (default: this computer's name).
WORKER_NAME=

# Whisper model from huggingface.co/onnx-community, downloaded once into CACHE_DIR:
#   onnx-community/whisper-large-v3-turbo  best quality (default), ~725 MB with DTYPE=q4
#   onnx-community/whisper-small           good
#   onnx-community/whisper-base            fair, fast, ~280 MB with DTYPE=fp32
#   onnx-community/whisper-tiny            rough, fastest, ~145 MB with DTYPE=fp32
MODEL=onnx-community/whisper-large-v3-turbo

# cpu (default). "dml" = DirectML GPU on Windows, "cuda" = NVIDIA on Linux. Falls back to cpu if it fails.
DEVICE=cpu

# Weight precision: q4, q8, fp16, fp32 ... or per file, e.g. encoder_model=fp32,decoder_model_merged=q8.
# Measured on an 8 kHz phone call (see README):
#   large-v3-turbo: q4 matches the browser app's transcript; q8 drops and repeats sentences.
#   tiny / base:    fp32 is the most accurate AND the fastest on CPU (tiny's q8 is unusable).
# When DTYPE is not set at all the worker uses q8 (the spec default), so keep this line.
DTYPE=q4

# Seconds between "any job for me?" checks when the queue is empty.
POLL_SECONDS=10

# Where models are stored.
CACHE_DIR=./models

# Optional:
# HEARTBEAT_SECONDS=60   # lease keep-alive / progress report interval (5-60)
# TEMP_DIR=./tmp         # downloaded audio while a job runs (deleted afterwards)
# FFMPEG_PATH=           # use another ffmpeg instead of the bundled one
# LOG_LEVEL=info         # debug for more detail
